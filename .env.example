# Copy to `.env` for local development. Production deployments should source
# their values from a secret manager (Kubernetes Secret, Vault, systemd
# `LoadCredential`, …) rather than committing a `.env` file.

# Development-only Signal frame scheduling probe; only active in builds with
# the conformance-harness feature. Leave unset for ordinary deployments.
# COLAND_CONFORMANCE_SIGNAL_EMISSION_PAUSE_FILE=./.local/conformance/signal-emission.pause

# Development-only Account cursor delivery probe; only active in builds with
# the conformance-harness feature. Leave unset for ordinary deployments.
# COLAND_CONFORMANCE_CURSOR_EMISSION_PAUSE_FILE=./.local/conformance/cursor-emission.json

# Optional absolute path to the normally paired native Agent runtime home.
# COLAND_ARKRET_RUNTIME_HOME=/var/lib/coland/arkret-runtime

# Optional third-party invite provider; requires COLAND_ACCOUNT_AUTHORITY_URL.
# COLAND_THIRD_PARTY_INVITE_PROVIDER_ENABLED=false

# Listen address. Use 0.0.0.0:8698 inside Docker.
COLAND_BIND=127.0.0.1:8698

# Advertised base URL surfaced in `/_arkret/describe` and DID metadata.
COLAND_PUBLIC_BASE_URL=http://127.0.0.1:8698
# Optional TLS. When both are set, coland starts a rustls HTTPS listener.
# For local testing, `mkcert local.host` produces the matching PEM files.
# COLAND_TLS_CERT_PATH=./local.host.pem
# COLAND_TLS_KEY_PATH=./local.host-key.pem

# The service identity is resolved from the durable service-identity record,
# Provider registration mapping, or a verified identity bundle. Development
# mode automatically provisions an identity for a fresh local database.
# For a first production boot without an external Provider, set this once and
# remove it after the first successful start:
# COLAND_FIRST_PROVISIONING=1

# Runtime persistence requires DATABASE_URL and durable key custody. Use the
# native current-user credential store, or an encrypted file whose random
# 32-byte base64 master key is mounted and backed up separately. For local
# development, `just init-dev` creates the file below without overwriting an
# existing valid key.
# COLAND_KEYSTORE_BACKEND=platform
# COLAND_KEYSTORE_BACKEND=encrypted_file
# COLAND_KEYSTORE_PATH=./.local/keystore/coland.v1
# COLAND_KEYSTORE_MASTER_KEY_FILE=./.local/secrets/coland-keystore-master-key
# COLAND_SERVICE_IDENTITY_BUNDLE_DIR=./.local/identity-bundle

# Built-in did:webvh identity provider. Enabled by default so coauth can offer
# this coland instance as the default registration provider. Set to false when
# all registration should go through an external provider.
COLAND_EMBEDDED_WEBVH_PROVIDER_ENABLED=true
# Required when the embedded provider is enabled. Configure the same secret in
# coauth; only requests with `Authorization: Bearer <secret>` may write webvh
# registration records.
# COLAND_EMBEDDED_WEBVH_REGISTRATION_BEARER=replace-with-secret
# Optional external did:webvh provider, for example a standalone did:webvh registrar.
# COLAND_EXTERNAL_WEBVH_PROVIDER_URL=https://webvh.example
# Optional provider id to preselect in coauth: `coland.embedded` or `external.webvh`.
# COLAND_DEFAULT_WEBVH_PROVIDER_ID=coland.embedded

# Production browser-session auth. Clients present a `ak.session.grant` + DPoP;
# coland verifies it by calling coauth's session-grant introspection endpoint
# with the shared per-edge secret below, presented as an HTTP Bearer token.
#
# The deployment-internal authenticated channel of service-http-binding.md
# §2.2.3 is registered only when the Account Authority URL, its explicit trust
# domain and the shared secret are all configured. The
# secret is the shared per-edge credential for both directions of that edge (it
# is coauth's `stations[].internal_authority_shared_secret`). It is not a
# general deployment credential. Coland uses it only for the four registered
# operations: exact-token introspection and Auth-side logout (outbound), the
# controller-gate attestation issue (outbound), and the device-revocation gate
# check (inbound). It grants nothing else on /_arkret/peer/*.
# In particular, Account Authority reads of `/_arkret/self/agents/{id}` and
# delegated `/_arkret/gate/account/agent-key-pair` commands use RFC 9421 signed
# service requests with the Station DID's exact `#account-authority` assertion
# method. This secret is never accepted for either route.
#
# Every plaintext proxy on this internal link is part of the trusted deployment
# TCB; Coland does not model or inspect the proxy chain.
# Every configured bearer target is bound at startup to the canonical
# COLAND_ACCOUNT_AUTHORITY_URL origin (same scheme, host, and effective port).
# Introspection/logout paths are exact, and URL credentials, query, or fragment
# are rejected before the process can send the bearer. The controller-gate URL
# is derived as the exact operation path on that same origin.
# COLAND_ACCOUNT_AUTHORITY_TRUST_DOMAIN=ak:trust_domain:coauth.example
# COLAND_SESSION_GRANT_INTROSPECTION_URL=http://coauth.internal:8080/_coauth/internal/session-grants/introspect
# COLAND_AUTH_SESSION_LOGOUT_URL=http://coauth.internal:8080/_coauth/internal/auth-sessions/logout
# COLAND_INTERNAL_AUTHORITY_SHARED_SECRET=shared-secret-known-by-coauth
# Alternatively load the per-edge secret from a mounted, non-empty file.
# Setting both the direct value and the file is rejected, even if they match.
# COLAND_INTERNAL_AUTHORITY_SHARED_SECRET_FILE=/run/secrets/internal-authority-shared-secret

# Production admin API allowlist. Comma-separated typed principal IDs; when
# development mode is false and this is empty, the admin API is closed.
# Browser sessions are still validated through the introspection settings above.
# COLAND_ADMIN_PRINCIPAL_IDS=ak:did_core:web:admin1.example,ak:did_core:web:admin2.example

# Required by every runtime binary. In-memory persistence is reserved for tests.
# DATABASE_URL=postgres://coland:coland@localhost:5432/coland

# Object storage for blob uploads. Use `filesystem` for local development or
# `s3-compatible` for S3, MinIO, R2, or another S3 API implementation.
COLAND_OBJECT_STORAGE_BACKEND=filesystem
# COLAND_OBJECT_STORAGE_LOCAL_ROOT=/var/lib/coland/objects
# COLAND_OBJECT_STORAGE_PREFIX=prod

# S3-compatible object storage:
# COLAND_OBJECT_STORAGE_BACKEND=s3-compatible
# COLAND_OBJECT_STORAGE_S3_BUCKET=coland
# COLAND_OBJECT_STORAGE_S3_REGION=us-east-1
# COLAND_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# COLAND_OBJECT_STORAGE_S3_ACCESS_KEY_ID=change-me
# COLAND_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# COLAND_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
# COLAND_OBJECT_STORAGE_S3_ALLOW_HTTP=false
# COLAND_OBJECT_STORAGE_S3_SESSION_TOKEN=change-me
# Test-only object stores may require unsigned requests. Do not enable for production S3.
# COLAND_OBJECT_STORAGE_S3_SKIP_SIGNATURE=false

# Single browser origin allowed by CORS. Leave unset to disable CORS.
# COLAND_CORS_ALLOW_ORIGIN=http://localhost:5173
# Public Account Authority base URL advertised through /_arkret/describe.
# Browser registration, recovery, and session-grant issuance call this service,
# not coland.
#
# This is the whole of the Account Authority configuration. The two variables
# below are overrides, not requirements: the Authority does not hold a service
# DID of its own, it signs as this Station under the `#account-authority`
# verification method in the Station's own DID document. So the service id it
# must present is this deployment's own, and its signing key is read from the
# Authority's published keyset on every startup.
#
# The Account Authority MUST be reachable whenever coland starts. Coland exits
# if discovery or JWKS loading fails, and it refuses an unexpected replacement
# key unless the operator explicitly approves it with the pin below.
# COLAND_ACCOUNT_AUTHORITY_URL=https://auth.local.host
# Override: name the Authority's signing key by hand instead of reading it from
# the keyset above. Enforced against the stored DID history on every boot; this
# explicit override permits a controlled DID key rotation.
# COLAND_ACCOUNT_AUTHORITY_PUBLIC_KEY_MULTIBASE=z6Mk...
# The Account Authority uses this Station's Service DID, even when the
# Account Authority URL points to a separate process or origin.
# OAuth/OIDC client_id this coland is registered as at the Account Authority process,
# advertised in describe.auth_metadata.methods[].oidc.client_id. coauth keys
# clients by ULID, so set this to the registered client id (not a human alias).
# COLAND_OAUTH_CLIENT_ID=01GFWR28C4KNE04WG3HKXB7C9R

# Defaults to `false`. Local development permits local network egress and
# diagnostics, never relaxed formal DID or signature verification. Synthetic
# dev-login/admin credentials require an explicit conformance-harness build.
COLAND_DEVELOPMENT_MODE=true

# Development-only fault injection for crash-consistency tests. Parsed once at
# startup and always empty unless development mode is on; an unknown failpoint
# id is a startup error, never a silently inert failpoint.
# COLAND_FAILPOINTS=backup_series_erase_durable_step=fail_after_durable_steps:1

# Security and trust posture.
COLAND_TRUST_DOMAIN=ak:trust_domain:local.host
# COLAND_DID_RESOLVER_ALLOW_METHODS=web,key,uuid
# COLAND_KEY_BACKUP_DAILY_DOWNLOAD_LIMIT=100
# Outbound requests reject private/link-local destinations by default outside
# development mode. The allow-private switch is authoritative and dangerous;
# prefer an explicit allowlist and denylist in production.
# COLAND_EGRESS_ALLOW_PRIVATE_NETWORKS=false
# COLAND_EGRESS_ALLOWED_HOSTS=api.example,*.trusted.example
# COLAND_EGRESS_DENYLIST=metadata.internal,169.254.169.254
# COLAND_FEDERATION_DENYLIST=blocked.example
# COLAND_FEDERATION_PEER_DENYLIST=did:web:blocked.example
# Under the sovereign enclave profile, outbound federation is additionally
# gated on the peer's verified trust_domain binding; peers whose trust_domain
# is absent from this CSV allowlist are denied.
# COLAND_FEDERATION_TRUST_DOMAIN_ALLOWLIST=partner.example
# External webvh provider probe expectations.
# COLAND_EXTERNAL_WEBVH_PROVIDER_TRUST_DOMAIN=ak:trust_domain:webvh.example

# Federation and push bridge.
# COLAND_FEDERATION_FANOUT_TOPOLOGY=mesh
# COLAND_FEDERATION_PEERS=https://peer-a.example,https://peer-b.example
# COLAND_FEDERATION_OUTBOUND=true
# Ack window for exact deactivation propagation to every durable affected Station.
# COLAND_DEACTIVATION_PROPAGATION_WINDOW_MS=86400000

# Account deactivation fanout to the push gateway (floria), per
# account-lifecycle.md §7.1. Deployments that run floria MUST set the URL, or
# the spec's gateway-side stop-delivery guarantee silently does not exist;
# unset declares the single-box/dev posture with no independent push gateway.
# Setting the bearer without the URL is rejected at startup.
# COLAND_DEACTIVATION_PUSH_GATEWAY_URL=https://push.example
# COLAND_DEACTIVATION_PUSH_GATEWAY_BEARER=changeme

# Media token issuer (media-service-binding.md §3). The key id defaults to
# `<service DID>#media-1` at request time when unset, so a single-key
# deployment needs no override. The TTL defaults to the recommended 300s and
# is clamped to the 600s hard ceiling regardless.
# COLAND_MEDIA_ISSUER_KID=did:web:example#media-1
# COLAND_MEDIA_TOKEN_TTL_SECONDS=300

# Admin pagination.
# COLAND_ADMIN_PAGE_LIMIT=100
# COLAND_ADMIN_MAX_PAGE_LIMIT=1000

# Upload staging.
# COLAND_RESUMABLE_UPLOAD_DIR=./coland-resumable-uploads
# COLAND_RESUMABLE_UPLOAD_TTL_SECS=86400

# Sovereign enclave profile.
# COLAND_SOVEREIGN_ENCLAVE=false
# COLAND_SOVEREIGN_ENCLAVE_ALLOWED_OUTBOUND_HOSTS=webvh.example,coauth.example

# Verified conformance profile advertisement.
# COLAND_VERIFIED_PROFILES_ARTIFACT=../cotest/artifacts/verified-profiles.json
# The test-only /_arkret/_conformance/* namespace (service-http-binding.md
# §2.1.2) is gated on the ak.profile.conformance_harness.v1 build profile, which
# is active iff COLAND_DEVELOPMENT_MODE=true. There is no separate enable flag;
# production deployments (development_mode=false) return 404 for that namespace.

# COLAND_TURN_SHARED_SECRET accepts the `_FILE` indirection: point this at a
# mounted secret file instead of setting the value directly. Setting both is
# rejected at startup, even if the values match.
# COLAND_TURN_SHARED_SECRET_FILE=/run/secrets/turn-shared-secret

# Internal account-authority authentication also accepts secret-file indirection.
# COLAND_INTERNAL_AUTHORITY_SHARED_SECRET_FILE=/run/secrets/internal-authority-shared-secret

# Explicitly onboard trusted public Push Gateways using a closed JSON array.
# Each entry binds the HTTPS origin, service DID and receipt assertion key.
# Empty means no independently operated gateway is trusted.
# COLAND_TRUSTED_PUSH_GATEWAYS=[]

# Durable security-rotation worker cadence in seconds; valid range is 1..=3600.
# COLAND_SECURITY_ROTATION_WORKER_INTERVAL_SECONDS=5

# WebSocket authorization lifetime in seconds, clamped to 1..=600.
# COLAND_WEBSOCKET_MAX_LIFETIME_SECS=600

# Deployment-wide autonomous Agent participation ceiling. All five bits default
# to true; a false bit disables that behavior in every enclosing scope.
# COLAND_AGENT_PARTICIPATION_CEILING={"reply_message":true,"reaction_add":true,"reaction_remove":true,"accept_third_party_mention":true,"act_on_behalf":true}

# Optional receive-policy constraints advertised in ServiceDescribe. CSV
# values are trimmed; omitting every variable leaves the constraint absent.
# COLAND_RECEIVE_POLICY_APPLIES_TO=invite_delivery,contact_request
# COLAND_RECEIVE_POLICY_PERMITTED_INTRODUCTION_KINDS=handle_claim,explicit_address
# COLAND_RECEIVE_POLICY_FORBIDDEN_INTRODUCTION_KINDS=
# COLAND_RECEIVE_POLICY_HANDLE_CLAIM_MAX_BEHAVIOR=notify
# COLAND_RECEIVE_POLICY_EXPLICIT_ADDRESS_MAX_BEHAVIOR=quarantine
# COLAND_RECEIVE_POLICY_UNKNOWN_INVITES_MAX_BEHAVIOR=drop
# Maximum disclosure level per trust tier; accepted values are `opaque` and
# `outcome`. Setting any tier emits a `disclosure_max` constraint; tiers left
# unset stay absent from it.
# COLAND_RECEIVE_POLICY_DISCLOSURE_HIGH_TRUST_MAX=outcome
# COLAND_RECEIVE_POLICY_DISCLOSURE_DISCOVERY_TRUST_MAX=opaque
# COLAND_RECEIVE_POLICY_DISCLOSURE_LOW_TRUST_MAX=opaque
# COLAND_RECEIVE_POLICY_ALLOWED_HANDLE_DOMAINS=example.org
# COLAND_RECEIVE_POLICY_TRUSTED_HANDLE_ISSUERS=did:web:issuer.example
# COLAND_RECEIVE_POLICY_TRUSTED_DIRECTORY_SERVICES=did:web:directory.example
# COLAND_RECEIVE_POLICY_TRUSTED_PRINCIPAL_SERVICES=did:web:principal.example
# COLAND_RECEIVE_POLICY_BLOCKED_PRINCIPAL_SERVICES=did:web:blocked.example
# COLAND_RECEIVE_POLICY_ACCEPTED_SUBJECT_DID_METHODS=web,webvh,key
# Per-holder new-source quotas remain enforced when these overrides are omitted.
# The values below are the protocol defaults; retention must be at least the window.
# COLAND_RECEIVE_POLICY_NEW_SOURCE_WINDOW_SECONDS=86400
# COLAND_RECEIVE_POLICY_NEW_SOURCE_DEFAULT_PER_WINDOW=3
# COLAND_RECEIVE_POLICY_NEW_SOURCE_MAX_PER_WINDOW=10
# COLAND_RECEIVE_POLICY_NEW_SOURCE_RETENTION_SECONDS=2592000
# COLAND_RECEIVE_POLICY_NEW_SOURCE_DEFAULT_PER_RETENTION=30
# COLAND_RECEIVE_POLICY_NEW_SOURCE_MAX_PER_RETENTION=200

# Runtime resource bounds and shutdown behavior.
# COLAND_TO_DEVICE_QUEUE_CAPACITY=10000
# Maximum concurrent applet transactions retained in memory.
# COLAND_APPLET_TRANSACTION_INFLIGHT_CAPACITY=64
# COLAND_SHUTDOWN_GRACE_SECS=30
# COLAND_DB_POOL_MAX_SIZE=32
# COLAND_DB_POOL_ACQUIRE_TIMEOUT_SECS=30
# Test/demo data is opt-in and must stay disabled in production.
# COLAND_SEED_DEMO_DATA=false

# Rate limiter ceilings (requests per window, per remote address, per class).
# Production defaults: probe=600, auth=60, api=300, other=600 over a 60s window;
# development_mode lifts every class far above a human's request rate so the
# shared loopback bucket does not trip 429 during local dev. The advertised
# describe `rate_limit_policy` always reflects these effective values.
# COLAND_RATE_LIMIT_WINDOW_SECONDS=60
# COLAND_RATE_LIMIT_DEFAULT_PER_MINUTE=600
# COLAND_RATE_LIMIT_AUTH_PER_MINUTE=60
# COLAND_RATE_LIMIT_API_PER_MINUTE=300
# COLAND_RATE_LIMIT_PROBE_PER_MINUTE=600

# Proxy and healthcheck helpers.
# COLAND_RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
# COLAND_HEALTHCHECK_URL=http://127.0.0.1:8698/readyz

# tracing-subscriber filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=coland=debug,salvo=info,warn
RUST_LOG=coland=info
