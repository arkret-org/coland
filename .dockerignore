# Top-level build artefacts. The `**/target/` glob is critical — a
# nested workspace-member or claude-worktree target/ would otherwise
# pour gigabytes into the build context.
target
**/target/
target-*
**/target-*/
.shared-target
.codex-tmp
.local
artifacts
# Deployment configuration is supplied at runtime; keep .env.example in source.
.env
.git
.github
*.log
**/node_modules/
